# 构建产物
out/
target/
*.o
*.a
*.so
*.dylib
*.dll
*.pdb

# DEPS 拉取的依赖（本地为指向 K:\flutter 的 junction），不入库
src/third_party/
src/flutter/third_party/
src/flutter/buildtools/
src/flutter/prebuilts/

# 工具缓存
.dart_tool/
__pycache__/
.gn_cache/
compile_commands.json

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store
src/out/

# Diagnostic output from the capture/drive scripts.
gal_err.log
upstream_catalog.json
upstream_icons.json

# Build artefacts and diagnostic output.
dist/
fps_*.log
audit_*.log
steady_*.log
alive.log
rel_err.log

# 临时运行日志
try_*.log
.cipd/
.gclient*
.port_batch_*/
.probe_*

# gclient sync 产物（真实 sync 而非 junction 时出现在仓库根）
/third_party/

# order_sweep.py 与 variant_sweep.py 变异期间的原文备份，绝不入库
*.sweep

# 手工变异期间的原文备份，同样绝不入库
*.bak
*.orig

# tools/dart/dump_ast.dart 的产物：33MB，且**绑定在某一个上游修订版上**。
# 入库会有两个坏处：仓库变大是小事，真正的问题是它会悄悄过期——
# 读它的人拿到的是上游"当时"的样子，而 tools/port.py 恰恰是用来
# 对齐上游"现在"的样子的。所以让它可重新生成，不让它被记住；
# 文件不在时 port.py 会直接打印出重新生成的命令。
/tools/upstream_ast.json

# dart2rust 的验证工程是独立 crate，不入 workspace，产物同样不入库
/tools/dart2rust/testdata/target/
/tools/dart2rust/testdata/Cargo.lock

# agree.py 的中间产物
/tools/dart2rust/.agree/
tools/dart2rust/.crate/
# The slice crates round 63 added. Generated, like `.crate/`, and forgetting
# them here swept 1500 generated files into a commit.
tools/dart2rust/.crate-*/
