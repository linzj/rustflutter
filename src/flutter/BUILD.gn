# rustflutter M0: minimal build entry.
#
# The upstream root BUILD.gn is preserved as BUILD.gn.upstream. It aggregates
# the full engine (embedders, //flutter/sky, gen_snapshot, dart_plugin_registrant,
# tonic tests, ...), all of which pull in the Dart SDK. It is re-enabled
# incrementally as each layer is de-Dart-ified; see PORTING_STATUS.md.
#
# What builds today is Tier A only: the rendering / compositing / text /
# threading stack, which has zero Dart coupling.

import("//build/toolchain/clang.gni")
import("//flutter/common/config.gni")

config("config") {
  include_dirs = [
    "..",
    ".",
  ]
  cflags = []
  if (is_win) {
    if (current_cpu != "x86") {
      cflags += [ "/WX" ]  # Treat warnings as errors.
    }
  }
  if (is_clang) {
    cflags += [ "-Wunreachable-code" ]
  }
}

config("export_dynamic_symbols") {
  # --dynamic-list is the GNU linker syntax supported by ELF linkers.
  # -exported_symbols_list is the macOS linker syntax. The different flags
  # accept files formatted differently, so we have exported_symbols.sym for GNU
  # linker syntax, and exported_symbols_mac.sym for the macOS linker syntax.
  if (is_linux || is_fuchsia) {
    inputs = [ "//flutter/common/exported_symbols.sym" ]
    ldflags = [ "-Wl,--dynamic-list=" + rebase_path(inputs[0], root_build_dir) ]
  } else if (is_mac) {
    inputs = [ "//flutter/common/exported_symbols_mac.sym" ]
    ldflags = [
      "-Xlinker",
      "-exported_symbols_list",
      "-Xlinker",
      rebase_path(inputs[0], root_build_dir),
    ]
  }
}

config("export_dynamic_test_symbols") {
  # See comment in :export_dynamic_symbols.
  # This config exposes an additional symbol meant for flutter_tester.
  if (is_linux || is_fuchsia) {
    inputs = [ "//flutter/common/exported_test_symbols.sym" ]
    ldflags = [ "-Wl,--dynamic-list=" + rebase_path(inputs[0], root_build_dir) ]
  } else if (is_mac) {
    inputs = [ "//flutter/common/exported_test_symbols_mac.sym" ]
    ldflags = [
      "-Xlinker",
      "-exported_symbols_list",
      "-Xlinker",
      rebase_path(inputs[0], root_build_dir),
    ]
  }
}

# The Dart-free rendering stack. This is the M0 build target.
group("tier_a") {
  public_deps = [
    "//flutter/display_list",
    "//flutter/flow",
    "//flutter/fml",
    "//flutter/impeller",
    "//flutter/txt",
  ]
}

# The Rust framework, its engine FFI shim, the CLI and the apps.
group("rust") {
  testonly = true
  public_deps = [ "//flutter/rust" ]
}

group("flutter") {
  testonly = true
  public_deps = [
    ":rust",
    ":tier_a",
  ]
}
