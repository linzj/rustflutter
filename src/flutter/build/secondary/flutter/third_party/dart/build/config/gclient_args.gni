# rustflutter shim.
#
# Upstream, this file is generated by gclient from the DEPS `gclient_gn_args`
# list and lands inside the Dart SDK checkout. ANGLE's gni/angle.gni imports it
# by that hardcoded path. The Dart SDK is not part of this checkout, so the file
# is provided here in GN's secondary source tree instead -- that keeps a
# third_party/dart directory from existing at all, and keeps the ANGLE checkout
# unpatched so it can stay a plain upstream dependency.
#
# Both values are Dart-SDK build knobs that are false for us in every case.
checkout_llvm = false
build_devtools_from_sources = false
