# The C++ side of the Rust <-> engine boundary. Everything it touches
# (display_list, flow, txt) is Dart-free upstream code used unmodified.
source_set("engine_ffi") {
  sources = [
    "rustflutter_ffi.cc",
    "rustflutter_ffi.h",
    "rustflutter_ffi_draw.cc",
    "rustflutter_ffi_handles.h",
    "rustflutter_ffi_internal.h",
  ]

  if (is_win) {
    sources += [ "rustflutter_window_win.cc" ]
  } else {
    sources += [ "rustflutter_window_stub.cc" ]
  }

  deps = [
    "//flutter/display_list",
    "//flutter/flow",
    "//flutter/fml",
    "//flutter/skia",
    "//flutter/txt",
  ]

  public_configs = [ "//flutter:config" ]

  # Marks this target as the one that *defines* the rf_* surface, so the
  # declarations in rustflutter_ffi.h annotate themselves for export. See
  # rustflutter_export.h; the engine is linked both ways from these objects.
  defines = [ "RUSTFLUTTER_ENGINE_IMPLEMENTATION" ]

  if (is_win) {
    libs = [
      "gdi32.lib",
      "user32.lib",
    ]
  }
}
