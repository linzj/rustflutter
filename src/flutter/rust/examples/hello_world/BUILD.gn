# The app itself: Rust, compiled to a staticlib so it can be linked with the
# C++ engine.
static_library("hello_world_rs") {
  crate_name = "hello_world"
  crate_root = "src/main.rs"

  sources = [ "src/main.rs" ]

  deps = [ "//flutter/rust/rustflutter" ]
}

executable("hello_world") {
  sources = [ "main.cc" ]

  deps = [
    ":hello_world_rs",
    "//flutter/rust/ffi:engine_ffi",
    "//flutter/rust/host",
  ]

  if (is_win) {
    # Pulled in by the Rust standard library.
    libs = [
      "advapi32.lib",
      "bcrypt.lib",
      "ntdll.lib",
      "userenv.lib",
      "ws2_32.lib",
    ]
  }
}
