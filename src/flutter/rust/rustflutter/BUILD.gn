# The framework crate. Apps depend on this; it in turn declares the extern "C"
# imports that //flutter/rust/ffi:engine_ffi provides at final link.
rust_library("rustflutter") {
  crate_name = "rustflutter"
  crate_root = "src/lib.rs"

  sources = [
    "src/engine.rs",
    "src/interactive_viewer.rs",
    "src/keyboard/keys.rs",
    "src/keyboard/mod.rs",
    "src/lib.rs",
    "src/widgets.rs",
  ]
}
