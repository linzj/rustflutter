# The host that puts a real Shell behind a real window. Upstream this role is
# played by shell/platform/<os>; this is the same job at a fraction of the size,
# because there is no plugin registrar and no embedder C API to serve -- only a
# window, the thread model, the shell, and the two platform channels the engine
# itself defines.
if (is_linux && !is_android) {
  import("//build/config/linux/pkg_config.gni")

  # The window layer. Resolved against the sysroot, which carries the GTK3
  # development headers so nothing has to be installed on the machine.
  pkg_config("gtk3") {
    packages = [ "gtk+-3.0" ]
  }
}

if (is_android) {
  # What tells the host where the application's entry point is. Separate from
  # `host` because it belongs to the *application*: it names
  # `rustflutter_app_main`, and the host must not. See the file itself, and
  # rustflutter_app.gni for who depends on it.
  #
  # A source_set rather than a static_library on purpose: its object goes on the
  # link line directly, and a load-time initialiser nothing references would not
  # survive being archived.
  source_set("app_entry") {
    sources = [ "android/rustflutter_app_entry.cc" ]

    public_configs = [ "//flutter:config" ]

    deps = [ "//flutter/rust/host" ]
  }
}

source_set("host") {
  sources = [
    "rustflutter_app_main.cc",
    "rustflutter_host.h",
  ]

  # Impeller on EGL, which is the same file on every platform that has EGL --
  # only where the EGL comes from differs, and this does not name it.
  if (is_win || is_android || is_linux) {
    sources += [
      "rustflutter_gl.cc",
      "rustflutter_gl.h",
    ]
  }

  if (is_win) {
    sources += [
      "rustflutter_host_a11y_win.cc",
      "rustflutter_host_a11y_win.h",
      "rustflutter_host_win.cc",

      # Impeller on Vulkan directly, without the ANGLE translation the GL path
      # goes through. Opt-in at run time through RUSTFLUTTER_BACKEND=vulkan.
      "rustflutter_vk.cc",
      "rustflutter_vk.h",

      # Generated. See tools/gen_key_map.py.
      "rustflutter_key_map_win.cc",
      "rustflutter_key_map_win.h",
    ]
  } else if (is_android) {
    sources += [ "rustflutter_host_android.cc" ]
  } else if (is_mac) {
    sources += [
      "rustflutter_host_mac.mm",

      # Generated. See tools/gen_key_map_mac.py.
      "rustflutter_key_map_mac.cc",
      "rustflutter_key_map_mac.h",
    ]
  } else if (is_linux) {
    sources += [
      "rustflutter_host_linux.cc",

      # Impeller on Vulkan directly, without the Mesa GL translation the EGL
      # path goes through. Opt-in at run time through RUSTFLUTTER_BACKEND=vulkan.
      "rustflutter_vk.cc",
      "rustflutter_vk.h",

      # Generated. See tools/gen_key_map_linux.py.
      "rustflutter_key_map_linux.cc",
      "rustflutter_key_map_linux.h",
    ]
  } else if (is_ios) {
    sources += [ "rustflutter_host_ios.mm" ]
  } else {
    sources += [ "rustflutter_host_stub.cc" ]
  }

  public_configs = [ "//flutter:config" ]

  # rf_host_run, rf_set_app_main and rf_app_main are defined here. See
  # rustflutter_export.h.
  defines = [ "RUSTFLUTTER_ENGINE_IMPLEMENTATION" ]

  deps = [
    "//flutter/common",
    "//flutter/fml",
    "//flutter/lib/ui:ui_types",
    "//flutter/runtime",
    "//flutter/rust/ffi:engine_ffi",
    "//flutter/shell/common",
    "//flutter/shell/gpu:gpu_surface_software",
    "//flutter/skia",

    # `flutter/platform` speaks JSON, and this is the JSON the engine already
    # vendors and parses its own channels with (shell/common/engine.cc).
    "//flutter/shell/platform/common:common_cpp_input",
    "//flutter/third_party/rapidjson",

    # `flutter/mousecursor` speaks the binary standard codec, and this is the
    # engine's own implementation of it rather than a second one.
    "//flutter/shell/platform/common/client_wrapper:standard_codec",
  ]

  if (is_win) {
    deps += [
      "//flutter/impeller",
      "//flutter/impeller/renderer/backend/gles",
      "//flutter/impeller/renderer/backend/vulkan",
      "//flutter/impeller/toolkit/egl",
      "//flutter/shell/gpu:gpu_surface_gl",
      "//flutter/shell/gpu:gpu_surface_vulkan",

      # The SPIR-V blobs Impeller's Vulkan backend is built from. Groups that
      # carry the vk variant only when impeller_enable_vulkan, which is on for
      # Windows by default.
      "//flutter/impeller/entity:entity_shaders",
      "//flutter/impeller/entity:framebuffer_blend_entity_shaders",
      "//flutter/impeller/entity:modern_entity_shaders",

      # libEGL_static MUST come before libGLESv2_static: reversed, the linker
      # reports DllMain already defined in LIBCMTD.lib.
      "//flutter/third_party/angle:libEGL_static",
      "//flutter/third_party/angle:libGLESv2_static",
    ]

    configs += [ "//flutter/third_party/angle:gl_prototypes" ]

    include_dirs = [ "//flutter/third_party/angle/include" ]

    libs = [
      # The composition clock, for the vsync waiter's frame interval.
      "dwmapi.lib",
      "gdi32.lib",

      # The IME. `flutter/textinput` is served through IMM32.
      "imm32.lib",

      # What a screen reader reads the interface through. `ole32` for the
      # apartment the provider lives in and `oleaut32` for the BSTRs and safe
      # arrays every answer is spelled in.
      "ole32.lib",
      "oleaut32.lib",
      "uiautomationcore.lib",
      "user32.lib",
    ]
  }

  if (is_android) {
    deps += [
      "//flutter/impeller",
      "//flutter/impeller/renderer/backend/gles",
      "//flutter/impeller/toolkit/egl",
      "//flutter/shell/gpu:gpu_surface_gl",
    ]

    libs = [
      # ANativeWindow, AChoreographer and the Looper the platform thread runs
      # on. All three are in libandroid.
      "android",
      "EGL",
      "GLESv2",

      # FML_LOG goes to logcat, which is where a device's output is read from.
      "log",
    ]
  }

  if (is_linux) {
    deps += [
      "//flutter/impeller",
      "//flutter/impeller/renderer/backend/gles",
      "//flutter/impeller/renderer/backend/vulkan",
      "//flutter/impeller/toolkit/egl",
      "//flutter/shell/gpu:gpu_surface_gl",
      "//flutter/shell/gpu:gpu_surface_vulkan",

      # The SPIR-V blobs Impeller's Vulkan backend is built from. Groups that
      # carry the vk variant only when impeller_enable_vulkan, which is on for
      # Linux by default.
      "//flutter/impeller/entity:entity_shaders",
      "//flutter/impeller/entity:framebuffer_blend_entity_shaders",
      "//flutter/impeller/entity:modern_entity_shaders",
    ]

    configs += [ ":gtk3" ]

    # EGL only, and deliberately not GLESv2 or vulkan: Impeller resolves every
    # GL symbol through eglGetProcAddress and the Vulkan loader is dlopened by
    # name, so neither is a load-time dependency -- and a machine without them
    # can still run the software path.
    libs = [ "EGL" ]
  }

  if (is_mac) {
    frameworks = [
      # The window, the view, the events and the pasteboard.
      "Cocoa.framework",

      # The bitmap the software surface is blitted through, and the display
      # mode the vsync waiter paces against.
      "CoreGraphics.framework",

      # CFStringGetLongCharacterForSurrogatePair, for a key that types an
      # astral character.
      "CoreFoundation.framework",

      # Writing the frame dump: the PNG encoder, and the type identifier that
      # says which encoder. See FrameBuffer::WritePng.
      "ImageIO.framework",
      "UniformTypeIdentifiers.framework",
    ]
  }

  if (is_ios) {
    frameworks = [
      # The window, the view, the touches and the pasteboard.
      "UIKit.framework",

      # The bitmap the software surface is blitted through.
      "CoreGraphics.framework",

      "CoreFoundation.framework",
      "Foundation.framework",
      "QuartzCore.framework",
    ]
  }
}
