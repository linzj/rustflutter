# The host that puts a real Shell behind a real window. Upstream this role is
# played by shell/platform/<os>; this is the same job at a fraction of the size,
# because there is no plugin registrar and no embedder C API to serve -- only a
# window, the thread model, the shell, and the two platform channels the engine
# itself defines.
source_set("host") {
  sources = [ "rustflutter_host.h" ]

  if (is_win) {
    sources += [
      "rustflutter_gl_win.cc",
      "rustflutter_gl_win.h",
      "rustflutter_host_win.cc",

      # Generated. See tools/gen_key_map.py.
      "rustflutter_key_map_win.cc",
      "rustflutter_key_map_win.h",
    ]
  } else {
    sources += [ "rustflutter_host_stub.cc" ]
  }

  public_configs = [ "//flutter:config" ]

  deps = [
    "//flutter/common",
    "//flutter/fml",
    "//flutter/lib/ui:ui_types",
    "//flutter/runtime",
    "//flutter/rust/ffi:engine_ffi",
    "//flutter/shell/common",
    "//flutter/shell/gpu:gpu_surface_software",
    "//flutter/skia",

    # `flutter/platform` speaks JSON, and this is the JSON the engine already
    # vendors and parses its own channels with (shell/common/engine.cc).
    "//flutter/third_party/rapidjson",
    "//flutter/shell/platform/common:common_cpp_input",

    # `flutter/mousecursor` speaks the binary standard codec, and this is the
    # engine's own implementation of it rather than a second one.
    "//flutter/shell/platform/common/client_wrapper:standard_codec",
  ]

  if (is_win) {
    deps += [
      "//flutter/impeller",
      "//flutter/impeller/renderer/backend/gles",
      "//flutter/impeller/toolkit/egl",
      "//flutter/shell/gpu:gpu_surface_gl",

      # libEGL_static MUST come before libGLESv2_static: reversed, the linker
      # reports DllMain already defined in LIBCMTD.lib.
      "//flutter/third_party/angle:libEGL_static",
      "//flutter/third_party/angle:libGLESv2_static",
    ]

    configs += [ "//flutter/third_party/angle:gl_prototypes" ]

    include_dirs = [ "//flutter/third_party/angle/include" ]

    libs = [
      # The composition clock, for the vsync waiter's frame interval.
      "dwmapi.lib",
      "gdi32.lib",

      # The IME. `flutter/textinput` is served through IMM32.
      "imm32.lib",
      "user32.lib",
    ]
  }
}
