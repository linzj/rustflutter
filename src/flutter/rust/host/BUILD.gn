# The host that puts a real Shell behind a real window. Upstream this role is
# played by shell/platform/<os>; this is the same job at a fraction of the size,
# because there is no plugin registrar and no embedder C API to serve -- only a
# window, the thread model, the shell, and the two platform channels the engine
# itself defines.
source_set("host") {
  sources = [ "rustflutter_host.h" ]

  # Impeller on EGL, which is the same file on every platform that has EGL --
  # only where the EGL comes from differs, and this does not name it.
  if (is_win || is_android) {
    sources += [
      "rustflutter_gl.cc",
      "rustflutter_gl.h",
    ]
  }

  if (is_win) {
    sources += [
      "rustflutter_host_a11y_win.cc",
      "rustflutter_host_a11y_win.h",
      "rustflutter_host_win.cc",

      # Generated. See tools/gen_key_map.py.
      "rustflutter_key_map_win.cc",
      "rustflutter_key_map_win.h",
    ]
  } else if (is_android) {
    sources += [ "rustflutter_host_android.cc" ]
  } else if (is_mac) {
    sources += [
      "rustflutter_host_mac.mm",

      # Generated. See tools/gen_key_map_mac.py.
      "rustflutter_key_map_mac.cc",
      "rustflutter_key_map_mac.h",
    ]
  } else {
    sources += [ "rustflutter_host_stub.cc" ]
  }

  public_configs = [ "//flutter:config" ]

  deps = [
    "//flutter/common",
    "//flutter/fml",
    "//flutter/lib/ui:ui_types",
    "//flutter/runtime",
    "//flutter/rust/ffi:engine_ffi",
    "//flutter/shell/common",
    "//flutter/shell/gpu:gpu_surface_software",
    "//flutter/skia",

    # `flutter/platform` speaks JSON, and this is the JSON the engine already
    # vendors and parses its own channels with (shell/common/engine.cc).
    "//flutter/third_party/rapidjson",
    "//flutter/shell/platform/common:common_cpp_input",

    # `flutter/mousecursor` speaks the binary standard codec, and this is the
    # engine's own implementation of it rather than a second one.
    "//flutter/shell/platform/common/client_wrapper:standard_codec",
  ]

  if (is_win) {
    deps += [
      "//flutter/impeller",
      "//flutter/impeller/renderer/backend/gles",
      "//flutter/impeller/toolkit/egl",
      "//flutter/shell/gpu:gpu_surface_gl",

      # libEGL_static MUST come before libGLESv2_static: reversed, the linker
      # reports DllMain already defined in LIBCMTD.lib.
      "//flutter/third_party/angle:libEGL_static",
      "//flutter/third_party/angle:libGLESv2_static",
    ]

    configs += [ "//flutter/third_party/angle:gl_prototypes" ]

    include_dirs = [ "//flutter/third_party/angle/include" ]

    libs = [
      # The composition clock, for the vsync waiter's frame interval.
      "dwmapi.lib",
      "gdi32.lib",

      # The IME. `flutter/textinput` is served through IMM32.
      "imm32.lib",

      # What a screen reader reads the interface through. `ole32` for the
      # apartment the provider lives in and `oleaut32` for the BSTRs and safe
      # arrays every answer is spelled in.
      "ole32.lib",
      "oleaut32.lib",
      "uiautomationcore.lib",
      "user32.lib",
    ]
  }

  if (is_android) {
    deps += [
      "//flutter/impeller",
      "//flutter/impeller/renderer/backend/gles",
      "//flutter/impeller/toolkit/egl",
      "//flutter/shell/gpu:gpu_surface_gl",
    ]

    libs = [
      # ANativeWindow, AChoreographer and the Looper the platform thread runs
      # on. All three are in libandroid.
      "android",
      "EGL",
      "GLESv2",

      # FML_LOG goes to logcat, which is where a device's output is read from.
      "log",
    ]
  }

  if (is_mac) {
    frameworks = [
      # The window, the view, the events and the pasteboard.
      "Cocoa.framework",

      # The bitmap the software surface is blitted through, and the display
      # mode the vsync waiter paces against.
      "CoreGraphics.framework",

      # CFStringGetLongCharacterForSurrogatePair, for a key that types an
      # astral character.
      "CoreFoundation.framework",

      # Writing the frame dump: the PNG encoder, and the type identifier that
      # says which encoder. See FrameBuffer::WritePng.
      "ImageIO.framework",
      "UniformTypeIdentifiers.framework",
    ]
  }
}
