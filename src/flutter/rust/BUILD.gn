  action("rustflutter_unittests") {
    testonly = true

    script = "run_rust_tests.py"

    sources = [
      "rustflutter/src/actions.rs",
      "rustflutter/src/app.rs",
      "rustflutter/src/arc.rs",
      "rustflutter/src/async.rs",
      "rustflutter/src/borders.rs",
      "rustflutter/src/cupertino.rs",
      "rustflutter/src/elevation_overlay.rs",
      "rustflutter/src/engine.rs",
      "rustflutter/src/engine_test_stubs.rs",
      "rustflutter/src/animation.rs",
      "rustflutter/src/color_scheme.rs",
      "rustflutter/src/colors.rs",
      "rustflutter/src/component_themes.rs",
      "rustflutter/src/components.rs",
      "rustflutter/src/controls.rs",
      "rustflutter/src/decoration.rs",
      "rustflutter/src/direction.rs",
      "rustflutter/src/display_feature.rs",
      "rustflutter/src/drag_boundary.rs",
      "rustflutter/src/drawer.rs",
      "rustflutter/src/dual_transition_builder.rs",
      "rustflutter/src/editable.rs",
      "rustflutter/src/expansion_panel.rs",
      "rustflutter/src/fab_location.rs",
      "rustflutter/src/flexible_space_bar.rs",
      "rustflutter/src/focus.rs",
