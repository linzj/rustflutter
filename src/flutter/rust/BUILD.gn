group("rust") {
  testonly = true

  deps = [
    "//flutter/rust/cli:rustflutter_cli",
    "//flutter/rust/examples/counter",
    "//flutter/rust/examples/cursor_demo",
    "//flutter/rust/examples/exit_demo",
    "//flutter/rust/examples/flutter_gallery",
    "//flutter/rust/examples/gallery",
    "//flutter/rust/examples/hello_world",
    "//flutter/rust/examples/platform_channels",
    "//flutter/rust/examples/settings_demo",
    "//flutter/rust/examples/showcase",
    "//flutter/rust/examples/text_demo",
    "//flutter/rust/ffi:engine_ffi",
    "//flutter/rust/host",
    "//flutter/rust/rustflutter",
  ]

  # The fold into `rustflutter_engine.lib` is a separate step from compiling
  # the objects it folds, and nothing else in this group links it: the apps
  # built here link the component archives directly, and only an *external*
  # Cargo build points rustc at the monolith. Without this line a default
  # `ninja -C out` compiled every object fresh and still left the archive a
  # stale one -- an application's `rerun-if-changed` on the archive then
  # noticed nothing, because the archive's own mtime never moved.
  deps += [ ":rustflutter_engine" ]

  # The tests run on the machine that builds them, so they exist only for a
  # host build. `enable_unittests` is already false for Android and iOS -- the
  # gn wrapper refuses to turn it on there -- so this is the same condition the
  # test targets themselves are declared under.
  if (enable_unittests) {
    deps += [
      ":rust_ffi_unittests",
      ":rustflutter_unittests",
      "//flutter/rust/examples/flutter_gallery:flutter_gallery_unittests",
    ]
  }
}
