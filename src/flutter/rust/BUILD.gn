    if (is_win) {
      _binary = "$root_out_dir/rustflutter_unittests.exe"
    } else {
      _binary = "$root_out_dir/rustflutter_unittests"
    }
    _stamp = "$target_gen_dir/rustflutter_unittests.stamp"
    outputs = [ _stamp ]

    args = [
      "--crate-root",
      rebase_path("rustflutter/src/lib.rs", root_build_dir),
      "--crate-name",
      "rustflutter_unittests",
