import("//build/toolchain/rust.gni")
import("//flutter/testing/testing.gni")

if (enable_unittests) {
  # Supplies the flutter::testing::GetFixturesPath() definition that
  # testing_lib references. No actual fixtures are needed here.
  test_fixtures("rust_ffi_fixtures") {
    fixtures = []
  }

  executable("rust_ffi_unittests") {
    testonly = true

    sources = [ "ffi_unittests.cc" ]

    deps = [
      ":rust_lib",
      ":rust_ffi_fixtures",
      "//flutter/rust/ffi:engine_ffi",
      "//flutter/rust/host",
      "//flutter/testing",
    ]

    if (is_win) {
      libs = [
        "advapi32.lib",
        "bcrypt.lib",
        "ntdll.lib",
        "userenv.lib",
        "ws2_32.lib",
      ]
    }
  }
}

# Everything an application has to link, in one archive.
#
# An application is a Rust program, and the natural way to build a Rust program
# is Cargo -- but it links the C++ engine, and the engine is built by GN. This
# is the seam between the two: `complete_static_lib` folds every object and
# archive the FFI and the host transitively depend on into a single
# `rustflutter_engine.lib`, which a `build.rs` can point `rustc` at without
# knowing anything about GN, ninja, or the several hundred objects behind it.
#
# What is deliberately *not* in here is the framework crate. Cargo compiles
# that from source as a path dependency, along with the application, so the
# application and the framework are one Rust compilation and this archive is
# only the C++ underneath them.
static_library("rustflutter_engine") {
  complete_static_lib = true

  deps = [
    "//flutter/rust/ffi:engine_ffi",
    "//flutter/rust/host",
  ]

  if (is_android || is_mac) {
    # Named here because nothing else names it. The buildroot adds libc++ as a
    # default dependency of every executable, loadable_module and
    # shared_library -- see BUILDCONFIG.gn -- and this is a static_library, so
    # it is the one target type that misses out. The application linking this
    # archive is the shared library (Android) or the Cargo binary (macOS), and
    # by then it is too late for GN to add anything.
    #
    # On Windows there is nothing missing: the MSVC runtime supplies what a
    # program actually reaches for -- thread-safe statics are
    # `_Init_thread_header`, not `__cxa_guard_acquire` -- and the libc++ sources
    # are not built at all in that configuration.
    #
    # On macOS there is, and it is not only the guard functions: this tree
    # builds libc++ into the inline namespace `std::__fl`, so the platform's own
    # `libc++.dylib` cannot supply a single one of the symbols the engine
    # references. Everything from `std::__fl::basic_string`'s out-of-line
    # members to the `basic_ostringstream` vtable `fml::LogMessage` needs has to
    # come from here.
    deps += [ "//flutter/third_party/libcxx" ]
  }
}

# The framework crate wrapped as a staticlib, so C++ targets can link it.
static_library("rust_lib") {
  crate_name = "rustflutter_staticlib"
  crate_root = "staticlib.rs"

  sources = [ "staticlib.rs" ]

  deps = [ "//flutter/rust/rustflutter" ]
}

# The framework crate's own #[test] functions. See run_rust_tests.py for why
# this is an action rather than a GN rust target.
