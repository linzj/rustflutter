import("//build/toolchain/rust.gni")
import("//flutter/testing/testing.gni")

if (enable_unittests) {
  # Supplies the flutter::testing::GetFixturesPath() definition that
  # testing_lib references. No actual fixtures are needed here.
  test_fixtures("rust_ffi_fixtures") {
    fixtures = []
  }

  executable("rust_ffi_unittests") {
    testonly = true

    sources = [ "ffi_unittests.cc" ]

    deps = [
      ":rust_lib",
      ":rust_ffi_fixtures",
      "//flutter/rust/ffi:engine_ffi",
      "//flutter/rust/host",
      "//flutter/testing",
    ]

    if (is_win) {
      libs = [
        "advapi32.lib",
        "bcrypt.lib",
        "ntdll.lib",
        "userenv.lib",
        "ws2_32.lib",
      ]
    }
  }
}

# Everything an application has to link, in one archive.
#
# An application is a Rust program, and the natural way to build a Rust program
# is Cargo -- but it links the C++ engine, and the engine is built by GN. This
# is the seam between the two: `complete_static_lib` folds every object and
# archive the FFI and the host transitively depend on into a single
# `rustflutter_engine.lib`, which a `build.rs` can point `rustc` at without
# knowing anything about GN, ninja, or the several hundred objects behind it.
#
# What is deliberately *not* in here is the framework crate. Cargo compiles
# that from source as a path dependency, along with the application, so the
# application and the framework are one Rust compilation and this archive is
# only the C++ underneath them.
static_library("rustflutter_engine") {
  complete_static_lib = true

  deps = [
    "//flutter/rust/ffi:engine_ffi",
    "//flutter/rust/host",
  ]
}

# The framework crate wrapped as a staticlib, so C++ targets can link it.
static_library("rust_lib") {
  crate_name = "rustflutter_staticlib"
  crate_root = "staticlib.rs"

  sources = [ "staticlib.rs" ]

  deps = [ "//flutter/rust/rustflutter" ]
}

# The framework crate's own #[test] functions. See run_rust_tests.py for why
# this is an action rather than a GN rust target.
if (enable_unittests) {
  action("rustflutter_unittests") {
    testonly = true

    script = "run_rust_tests.py"

    sources = [
      "rustflutter/src/app.rs",
      "rustflutter/src/engine.rs",
      "rustflutter/src/engine_test_stubs.rs",
      "rustflutter/src/animation.rs",
      "rustflutter/src/components.rs",
      "rustflutter/src/controls.rs",
      "rustflutter/src/framework.rs",
      "rustflutter/src/gestures.rs",
      "rustflutter/src/keyboard/keys.rs",
      "rustflutter/src/keyboard/mod.rs",
      "rustflutter/src/lib.rs",
      "rustflutter/src/navigation.rs",
      "rustflutter/src/painting.rs",
      "rustflutter/src/render.rs",
      "rustflutter/src/services/channel.rs",
      "rustflutter/src/services/codec.rs",
      "rustflutter/src/services/mod.rs",
      "rustflutter/src/services/system.rs",
      "rustflutter/src/widgets.rs",
    ]

    if (is_win) {
      _binary = "$root_out_dir/rustflutter_unittests.exe"
    } else {
      _binary = "$root_out_dir/rustflutter_unittests"
    }
    _stamp = "$target_gen_dir/rustflutter_unittests.stamp"
    outputs = [ _stamp ]

    args = [
      "--crate-root",
      rebase_path("rustflutter/src/lib.rs", root_build_dir),
      "--crate-name",
      "rustflutter_unittests",
      "--output",
      rebase_path(_binary, root_build_dir),
      "--rustc",
      rustc_path,
      "--edition",
      rust_edition,
      "--stamp",
      rebase_path(_stamp, root_build_dir),
    ]

    if (is_win) {
      args += [
        "--linker",
        rebase_path("//flutter/buildtools/windows-x64/clang/bin/lld-link.exe",
                    root_build_dir),
      ]
    }
  }
}

group("rust") {
  testonly = true

  deps = [
    ":rust_ffi_unittests",
    ":rustflutter_unittests",
    "//flutter/rust/cli:rustflutter_cli",
    "//flutter/rust/examples/counter",
    "//flutter/rust/examples/flutter_gallery",
    "//flutter/rust/examples/flutter_gallery:flutter_gallery_unittests",
    "//flutter/rust/examples/gallery",
    "//flutter/rust/examples/hello_world",
    "//flutter/rust/examples/platform_channels",
    "//flutter/rust/examples/showcase",
    "//flutter/rust/ffi:engine_ffi",
    "//flutter/rust/host",
    "//flutter/rust/rustflutter",
  ]
}
