# Generated by `rustflutter create hello_world_app`.

# The app itself. Rust, compiled to a staticlib so it links with the C++ engine.
static_library("hello_world_app_rs") {
  crate_name = "hello_world_app"
  crate_root = "src/main.rs"

  sources = [ "src/main.rs" ]

  deps = [ "//flutter/rust/rustflutter" ]
}

executable("hello_world_app") {
  sources = [ "main.cc" ]

  deps = [
    ":hello_world_app_rs",
    "//flutter/rust/ffi:engine_ffi",
    "//flutter/rust/host",
  ]

  if (is_win) {
    # Pulled in by the Rust standard library.
    libs = [
      "advapi32.lib",
      "bcrypt.lib",
      "ntdll.lib",
      "userenv.lib",
      "ws2_32.lib",
    ]
  }
}
