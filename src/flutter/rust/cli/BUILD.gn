# Project tooling: `rustflutter create` / `list` / `build` / `run`.
# Pure Rust with no engine dependency.
static_library("cli_rs") {
  crate_name = "rustflutter_cli"
  crate_root = "src/main.rs"

  sources = [
    "src/main.rs",
    "src/templates.rs",
  ]
}

executable("rustflutter_cli") {
  output_name = "rustflutter"

  sources = [ "main.cc" ]

  deps = [ ":cli_rs" ]

  if (is_win) {
    # Pulled in by the Rust standard library.
    libs = [
      "advapi32.lib",
      "bcrypt.lib",
      "ntdll.lib",
      "userenv.lib",
      "ws2_32.lib",
    ]
  }
}
