#
# rustflutter: lib/ui is split in two.
#
#   :ui_types   The parts of lib/ui that are plain C++ -- viewport metrics,
#               pointer/key packets, platform messages, semantics nodes, the
#               font collection, the image generator registry. These never
#               touched Dart to begin with (measured: 0 Dart references in all
#               but five files, and those five only had binding entry points
#               bolted onto otherwise plain data). shell/common depends on this
#               and nothing more.
#
#   :ui         The dart:ui object wrappers -- Canvas, Path, Paint, Paragraph,
#               SceneBuilder, Image and friends. 73 of them still inherit
#               RefCountedDartWrappable<T> or take Dart_Handle constructor
#               arguments, so they do not compile. De-Dart-ifying them is M4;
#               until then this stays an empty group so the label resolves.
#               The real rules are preserved in BUILD.gn.upstream.

source_set("ui_types") {
  sources = [
    "floating_point.h",
    "io_manager.h",
    "painting/image_generator.cc",
    "painting/image_generator.h",
    "painting/image_generator_apng.cc",
    "painting/image_generator_apng.h",
    "painting/image_generator_registry.cc",
    "painting/image_generator_registry.h",
    "semantics/custom_accessibility_action.cc",
    "semantics/custom_accessibility_action.h",
    "semantics/semantics_flags.h",
    "semantics/semantics_node.cc",
    "semantics/semantics_node.h",
    "semantics/string_attribute.h",
    "snapshot_delegate.h",
    "text/asset_manager_font_provider.cc",
    "text/asset_manager_font_provider.h",
    "text/font_collection.cc",
    "text/font_collection.h",
    "window/hit_test_response.h",
    "window/key_data.cc",
    "window/key_data.h",
    "window/key_data_packet.cc",
    "window/key_data_packet.h",
    "window/platform_message.cc",
    "window/platform_message.h",
    "window/platform_message_response.cc",
    "window/platform_message_response.h",
    "window/point_data.h",
    "window/pointer_data.cc",
    "window/pointer_data.h",
    "window/pointer_data_packet.cc",
    "window/pointer_data_packet.h",
    "window/pointer_data_packet_converter.cc",
    "window/pointer_data_packet_converter.h",
    "window/view_focus.cc",
    "window/view_focus.h",
    "window/viewport_metrics.cc",
    "window/viewport_metrics.h",
  ]

  public_configs = [ "//flutter:config" ]

  public_deps = [
    "//flutter/shell/common:platform_message_handler",
    "//flutter/shell/common:snapshot_pixel_format",
    "//flutter/txt",
  ]

  deps = [
    "//flutter/assets",
    "//flutter/common",
    "//flutter/common/graphics",
    "//flutter/display_list",
    "//flutter/flow",
    "//flutter/fml",
    "//flutter/skia",
    "//flutter/test_font",
    "//flutter/third_party/rapidjson",
  ]
}

group("ui") {
  public_deps = [ ":ui_types" ]
}
